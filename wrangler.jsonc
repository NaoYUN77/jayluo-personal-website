{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pseroanl-blog-notes-website",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/about",
      "/about/",
      "/projects",
      "/projects/",
      "/contact",
      "/contact/",
      "/search",
      "/search/",
      "/tags",
      "/tags/",
      "/blog",
      "/blog/*",
      "/notes",
      "/notes/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/images/*",
      "!/en",
      "!/en/*"
    ]
  },
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jayluo-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
