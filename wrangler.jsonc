{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pseroanl-blog-notes-website",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jayluo-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
