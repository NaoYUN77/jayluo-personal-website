---
import type { GetStaticPaths, Page } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { listingMetadata } from '@/lib/seo/metadata'

import { Paginator } from 'astro-pure/components/pages'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allNotes = (await getCollection('notesEn')).filter(
    (entry) => !entry.data.draft && entry.data.translationKey
  )
  const uniqueTags = [...new Set(allNotes.flatMap((entry) => entry.data.tags))]

  return uniqueTags.flatMap((tag) => {
    const filteredEntries = allNotes
      .filter((entry) => entry.data.tags.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

    return paginate(filteredEntries, {
      params: { tag },
      pageSize: 10
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'notesEn'>>
}

const { page } = Astro.props
const { tag } = Astro.params

const statusIcons: Record<string, string> = {
  'in-progress': '🚧',
  incomplete: '⏸️',
  ready: '✅',
  archived: '📦'
}

const typeIcons: Record<string, string> = {
  note: '📝',
  snippet: '💡',
  draft: '✏️',
  idea: '🔮',
  research: '🔬',
  reference: '📚'
}

const meta = listingMetadata(
  'notes',
  true,
  page.currentPage,
  page.data.map((entry) => entry.data.title),
  tag
)

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← Previous Entries',
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: 'Next Entries →',
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/en/notes' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='mb-2 flex items-center gap-2'>
        <Icon name='tag-2' class='text-muted-foreground' />
        <h1 class='text-3xl font-medium'>{tag}</h1>
      </div>
      <p class='mb-6 text-muted-foreground'>
        {page.total}
        {page.total === 1 ? ' entry' : ' entries'} with this tag
      </p>
    </div>

    <section id='content' class='animate' aria-label='Note entries'>
      <ul class='space-y-3'>
        {
          page.data.map((entry) => (
            <li class='glass-surface glass-interactive group relative rounded-lg p-4'>
              <a href={`/en/notes/${entry.data.translationKey}`} class='block' data-astro-prefetch>
                <div class='mb-2 flex items-start gap-3'>
                  <div class='mt-0.5 shrink-0 text-xl opacity-70 group-hover:opacity-100'>
                    {typeIcons[entry.data.type] ?? '📝'}
                  </div>
                  <div class='min-w-0 flex-1'>
                    <div class='mb-1 flex items-start justify-between gap-4'>
                      <h3 class='font-medium leading-tight group-hover:text-foreground'>
                        {entry.data.title}
                      </h3>
                      <span class='shrink-0 text-xs'>{statusIcons[entry.data.status]}</span>
                    </div>
                    {entry.data.description && (
                      <p class='mb-2 text-sm text-muted-foreground'>{entry.data.description}</p>
                    )}
                    <div class='flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
                      <time datetime={entry.data.date.toISOString()}>
                        {entry.data.date.toLocaleDateString('en', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                      {entry.data.updatedDate && (
                        <span>
                          · Updated{' '}
                          {entry.data.updatedDate.toLocaleDateString('en', {
                            month: 'short',
                            day: 'numeric'
                          })}
                        </span>
                      )}
                      {entry.data.tags.length > 1 && (
                        <>
                          <span>·</span>
                          <div class='flex flex-wrap gap-1'>
                            {entry.data.tags
                              .filter((item) => item !== tag)
                              .map((item) => (
                                <span class='rounded bg-muted px-1.5 py-0.5'>{item}</span>
                              ))}
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      {
        page.lastPage > 1 && (
          <div class='mt-8'>
            <Paginator {...paginationProps} />
          </div>
        )
      }
    </section>
  </main>
</PageLayout>
