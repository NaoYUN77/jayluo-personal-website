---
import { getCollection } from 'astro:content'
import { getProjects } from '@/data/projects'

import PageLayout from '@/layouts/BaseLayout.astro'
import HomeLanding from '@/components/home/HomeLanding.astro'

export const prerender = true

const MAX_POSTS = 5
const MAX_NOTES = 4

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      +(b.data.updatedDate ?? b.data.publishDate) - +(a.data.updatedDate ?? a.data.publishDate)
  )
  .slice(0, MAX_POSTS)

const notes = (await getCollection('notes'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, MAX_NOTES)

const featuredProjects = getProjects('zh').filter((project) => project.featured)
---

<PageLayout meta={{ title: 'Home' }}>
  <HomeLanding
    lang='zh'
    posts={posts.map((post) => ({
      title: post.data.title,
      href: `/blog/${post.id}`,
      date: post.data.updatedDate ?? post.data.publishDate,
      tags: post.data.tags
    }))}
    notes={notes.map((note) => ({ title: note.data.title, href: `/notes/${note.id}` }))}
    projects={featuredProjects}
  />
</PageLayout>
