---
import 'katex/dist/katex.min.css'

import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

type MathSnippet = {
  label: string
  tex: string
  /** 插入后默认选中的占位片段，方便直接替换。 */
  select?: string
  /** 块级公式会单独成段，与文章里的 $$...$$ 保持一致。 */
  display?: boolean
}

const mathSnippetGroups: { title: string; display?: boolean; items: MathSnippet[] }[] = [
  {
    title: '基础',
    items: [
      { label: '分数', tex: String.raw`\frac{a}{b}`, select: 'a' },
      { label: '幂', tex: String.raw`x^{n}`, select: 'n' },
      { label: '下标', tex: String.raw`a_{i}`, select: 'i' },
      { label: '平方根', tex: String.raw`\sqrt{x}`, select: 'x' },
      { label: 'n 次根', tex: String.raw`\sqrt[n]{x}`, select: 'n' },
      { label: '括号', tex: String.raw`\left( x \right)`, select: 'x' },
      { label: '绝对值', tex: String.raw`\left| x \right|`, select: 'x' },
      { label: '组合数', tex: String.raw`\binom{n}{k}`, select: 'n' }
    ]
  },
  {
    title: '求和 / 积分 / 极限',
    display: true,
    items: [
      { label: '求和', tex: String.raw`\sum_{i=1}^{n} a_i`, select: 'i=1' },
      { label: '连乘', tex: String.raw`\prod_{i=1}^{n} a_i`, select: 'i=1' },
      { label: '积分', tex: String.raw`\int_{a}^{b} f(x)\,\mathrm{d}x`, select: 'a' },
      {
        label: '二重积分',
        tex: String.raw`\iint_{D} f(x,y)\,\mathrm{d}x\,\mathrm{d}y`,
        select: 'D'
      },
      {
        label: '极限',
        tex: String.raw`\lim_{x \to \infty} f(x)`,
        select: String.raw`x \to \infty`
      },
      { label: '导数', tex: String.raw`\frac{\mathrm{d}y}{\mathrm{d}x}`, select: 'y' },
      { label: '偏导', tex: String.raw`\frac{\partial f}{\partial x}`, select: 'f' }
    ]
  },
  {
    title: '运算与关系',
    items: [
      { label: '≠', tex: String.raw`\neq` },
      { label: '≤', tex: String.raw`\leq` },
      { label: '≥', tex: String.raw`\geq` },
      { label: '≈', tex: String.raw`\approx` },
      { label: '∝', tex: String.raw`\propto` },
      { label: '±', tex: String.raw`\pm` },
      { label: '×', tex: String.raw`\times` },
      { label: '÷', tex: String.raw`\div` },
      { label: '·', tex: String.raw`\cdot` },
      { label: '∞', tex: String.raw`\infty` }
    ]
  },
  {
    title: '希腊字母',
    items: [
      { label: 'α', tex: String.raw`\alpha` },
      { label: 'β', tex: String.raw`\beta` },
      { label: 'γ', tex: String.raw`\gamma` },
      { label: 'δ', tex: String.raw`\delta` },
      { label: 'θ', tex: String.raw`\theta` },
      { label: 'λ', tex: String.raw`\lambda` },
      { label: 'μ', tex: String.raw`\mu` },
      { label: 'π', tex: String.raw`\pi` },
      { label: 'σ', tex: String.raw`\sigma` },
      { label: 'φ', tex: String.raw`\varphi` },
      { label: 'ω', tex: String.raw`\omega` },
      { label: 'Δ', tex: String.raw`\Delta` },
      { label: 'Σ', tex: String.raw`\Sigma` },
      { label: 'Ω', tex: String.raw`\Omega` }
    ]
  },
  {
    title: '矩阵 / 分段',
    display: true,
    items: [
      {
        label: '矩阵',
        tex: String.raw`\begin{matrix} a & b \\ c & d \end{matrix}`,
        select: 'a & b'
      },
      {
        label: '括号矩阵',
        tex: String.raw`\begin{pmatrix} a & b \\ c & d \end{pmatrix}`,
        select: 'a & b'
      },
      {
        label: '行列式',
        tex: String.raw`\begin{vmatrix} a & b \\ c & d \end{vmatrix}`,
        select: 'a & b'
      },
      {
        label: '分段函数',
        tex: String.raw`f(x) = \begin{cases} x, & x \geq 0 \\ -x, & x < 0 \end{cases}`,
        select: 'x, & x \\geq 0'
      },
      {
        label: '多行对齐',
        tex: String.raw`\begin{aligned} a &= b + c \\ d &= e + f \end{aligned}`,
        select: 'a &= b + c'
      }
    ]
  },
  {
    title: '箭头 / 集合 / 装饰',
    items: [
      { label: '→', tex: String.raw`\to` },
      { label: '⇒', tex: String.raw`\Rightarrow` },
      { label: '⇔', tex: String.raw`\Leftrightarrow` },
      { label: '∈', tex: String.raw`\in` },
      { label: '∉', tex: String.raw`\notin` },
      { label: '⊆', tex: String.raw`\subseteq` },
      { label: '∪', tex: String.raw`\cup` },
      { label: '∩', tex: String.raw`\cap` },
      { label: '∀', tex: String.raw`\forall` },
      { label: '∃', tex: String.raw`\exists` },
      { label: '∅', tex: String.raw`\emptyset` },
      { label: 'ℝ', tex: String.raw`\mathbb{R}` },
      { label: '向量', tex: String.raw`\vec{v}`, select: 'v' },
      { label: '估计', tex: String.raw`\hat{x}`, select: 'x' },
      { label: '平均', tex: String.raw`\bar{x}`, select: 'x' },
      { label: '上划线', tex: String.raw`\overline{AB}`, select: 'AB' }
    ]
  }
]
---

<BaseLayout meta={{ title: '管理后台', description: 'Jayluo blog 内容管理入口。', noindex: true }}>
  <main class='admin-page animate'>
    <header class='admin-toolbar'>
      <div>
        <p class='admin-eyebrow'>JAYLUO / ADMIN</p>
        <h1>内容管理</h1>
        <p class='admin-subtitle'>在这里写草稿，保存后由 blog 机器人润色发布。</p>
      </div>
      <div class='admin-toolbar-actions'>
        <span id='admin-connection' class='admin-chip' data-state='idle'>未连接</span>
        <a class='admin-btn admin-btn-ghost' href='/blog' target='_blank' rel='noopener'>
          前台预览
        </a>
      </div>
    </header>

    <details id='admin-auth' class='admin-card admin-auth' open>
      <summary class='admin-auth-summary'>
        <span>Content API 连接</span>
        <span id='admin-auth-badge' class='admin-chip' data-state='idle'>未连接</span>
      </summary>
      <form id='admin-auth-form' class='admin-auth-form'>
        <label class='admin-field'>
          <span>Content API token</span>
          <input
            id='admin-token'
            type='password'
            autocomplete='off'
            spellcheck='false'
            placeholder='粘贴 CONTENT_API_TOKEN'
            required
          />
        </label>
        <button class='admin-btn' type='submit'>连接并加载</button>
        <p id='admin-auth-status' class='admin-status' aria-live='polite'>
          Token 只保存在当前浏览器的 localStorage。
        </p>
      </form>
    </details>

    <section class='admin-card admin-editor'>
      <div class='admin-card-head admin-editor-head'>
        <div class='admin-editor-heading'>
          <h2 id='admin-form-title'>写文章</h2>
          <span id='admin-form-context' class='admin-chip' hidden></span>
          <span id='admin-draft-chip' class='admin-chip admin-chip-draft'>草稿</span>
        </div>
        <div class='admin-collection' role='group' aria-label='文章归属'>
          <button class='admin-btn admin-btn-ghost is-active' type='button' data-collection='posts'>
            blog
          </button>
          <button class='admin-btn admin-btn-ghost' type='button' data-collection='notes'>
            notes
          </button>
          <button class='admin-btn admin-btn-ghost' type='button' id='admin-refresh'>
            刷新列表
          </button>
        </div>
      </div>

      <div id='admin-autosave' class='admin-autosave' hidden>
        <span id='admin-autosave-text'>发现本机自动保存。</span>
        <button
          class='admin-btn admin-btn-ghost admin-row-btn'
          type='button'
          id='admin-autosave-restore'
        >
          恢复
        </button>
        <button
          class='admin-btn admin-btn-ghost admin-row-btn'
          type='button'
          id='admin-autosave-discard'
        >
          忽略
        </button>
      </div>

      <form id='admin-form' class='admin-editor-form' novalidate>
        <div class='admin-writing-head'>
          <label class='admin-field admin-title-field'>
            <span class='admin-field-label'>
              <span>标题</span>
              <span id='admin-title-count' class='admin-limit'>0 / 60</span>
            </span>
            <input
              id='admin-title'
              maxlength='60'
              autocomplete='off'
              placeholder='给这篇文章一个标题'
            />
          </label>

          <label class='admin-field admin-desc-field'>
            <span class='admin-field-label'>
              <span>摘要</span>
              <span id='admin-desc-count' class='admin-limit'>0 / 160</span>
            </span>
            <input
              id='admin-description'
              maxlength='160'
              autocomplete='off'
              placeholder='一句话说清楚这篇内容（留空会自动取正文开头）'
            />
          </label>
        </div>

        <div class='admin-editor-bar'>
          <div class='admin-view-switch' role='group' aria-label='编辑器视图'>
            <button type='button' data-view='write'>写作</button>
            <button type='button' data-view='split' class='is-active'>分栏</button>
            <button type='button' data-view='preview'>预览</button>
          </div>
          <div class='admin-editor-tools' role='toolbar' aria-label='Markdown 快捷工具'>
            <div class='admin-tool-group' role='group' aria-label='撤销与重做'>
              <button type='button' data-md='undo' title='撤销（Ctrl/Cmd + Z）' aria-label='撤销'>
                ↶
              </button>
              <button
                type='button'
                data-md='redo'
                title='重做（Ctrl/Cmd + Shift + Z）'
                aria-label='重做'
              >
                ↷
              </button>
            </div>
            <div class='admin-tool-group' role='group' aria-label='标题'>
              <button type='button' data-md='h1' title='一级标题（Ctrl/Cmd + Alt + 1）'>H1</button>
              <button type='button' data-md='h2' title='二级标题（Ctrl/Cmd + Alt + 2）'>H2</button>
              <button type='button' data-md='h3' title='三级标题（Ctrl/Cmd + Alt + 3）'>H3</button>
            </div>
            <div class='admin-tool-group' role='group' aria-label='文字样式'>
              <button type='button' data-md='bold' title='加粗（Ctrl/Cmd + B）'>B</button>
              <button type='button' data-md='italic' title='斜体（Ctrl/Cmd + I）'><em>I</em></button
              >
              <button type='button' data-md='underline' title='下划线（插入 HTML <u> 标签）'>
                <u>U</u>
              </button>
              <button type='button' data-md='strike' title='删除线（Ctrl/Cmd + Shift + X）'>
                <s>S</s>
              </button>
            </div>
            <div class='admin-tool-group' role='group' aria-label='插入'>
              <button type='button' data-md='link' title='链接（Ctrl/Cmd + K）'>链接</button>
              <button type='button' data-md='image' title='插入图片（使用图片 URL）'>图片</button>
              <button type='button' data-md='code' title='行内代码'>代码</button>
              <button type='button' data-md='codeblock' title='代码块（可在 ``` 后输入语言）'>
                代码块
              </button>
              <button type='button' data-md='math' title='行内公式（$...$）'>$x$</button>
              <button type='button' data-md='mathblock' title='块级公式（$$...$$）'>$$x$$</button>
            </div>
            <div class='admin-tool-group' role='group' aria-label='列表与块'>
              <button type='button' data-md='ul' title='无序列表（Ctrl/Cmd + Shift + 8）'>•</button>
              <button type='button' data-md='ol' title='有序列表（Ctrl/Cmd + Shift + 7）'>1.</button
              >
              <button type='button' data-md='quote' title='引用（Ctrl/Cmd + Shift + .）'
                >引用</button
              >
              <button type='button' data-md='hr' title='分割线'>分割线</button>
            </div>
          </div>

          <details id='admin-math' class='admin-math'>
            <summary class='admin-math-summary'>
              <span>数学公式</span>
              <span class='admin-math-hint'>KaTeX · 展开后点击模板即可插入</span>
            </summary>
            <div class='admin-math-body'>
              <section class='admin-math-group'>
                <p class='admin-math-label'>快速插入</p>
                <div class='admin-math-grid'>
                  <button type='button' data-md='math' title='把选中的文字包成行内公式'>
                    行内公式 $…$
                  </button>
                  <button type='button' data-md='mathblock' title='插入独立成段的显示公式'>
                    块级公式 $$…$$
                  </button>
                </div>
              </section>
              {
                mathSnippetGroups.map((group) => (
                  <section class='admin-math-group'>
                    <p class='admin-math-label'>{group.title}</p>
                    <div class='admin-math-grid'>
                      {group.items.map((snippet) => (
                        <button
                          type='button'
                          data-math-tex={snippet.tex}
                          data-math-select={snippet.select}
                          data-math-display={
                            (snippet.display ?? group.display) ? 'block' : 'inline'
                          }
                          title={`${(snippet.display ?? group.display) ? '块级' : '行内'}公式：${snippet.tex}`}
                        >
                          {snippet.label}
                        </button>
                      ))}
                    </div>
                  </section>
                ))
              }
              <p class='admin-math-note'>
                行内公式用 <code>$…$</code>，块级公式用单独成段的 <code>$$…$$</code
                >；预览与文章正文使用同一套 KaTeX 渲染。
              </p>
            </div>
          </details>

          <span id='admin-body-stats' class='admin-body-stats'>0 字 · 约 1 分钟</span>
        </div>

        <div id='admin-panes' class='admin-panes' data-view='split'>
          <textarea
            id='admin-body'
            class='admin-body'
            spellcheck='true'
            aria-label='正文 Markdown'
            placeholder='从这里开始写 Markdown…'></textarea>
          <div class='admin-preview-wrap'>
            <article
              id='admin-preview'
              class='admin-preview prose prose-pure dark:prose-invert max-w-none'
              aria-label='Markdown 预览'
            >
            </article>
          </div>
        </div>

        <details class='admin-settings'>
          <summary>
            <span id='admin-settings-title'>文章设置</span>
            <span id='admin-settings-hint' class='admin-settings-hint'>
              URL ID、日期、语言、标签、格式
            </span>
          </summary>
          <div class='admin-fields'>
            <label class='admin-field'>
              <span class='admin-field-label'>
                <span>URL ID</span>
                <span class='admin-limit'>选填</span>
              </span>
              <input
                id='admin-id'
                pattern='[a-z0-9][a-z0-9-]*'
                spellcheck='false'
                placeholder='留空会按标题自动生成'
              />
              <small class='admin-hint'>只能使用小写字母、数字和连字符，保存后不可修改。</small>
            </label>

            <label class='admin-field'>
              <span class='admin-field-label'>
                <span>语言</span>
                <span id='admin-locale-hint' class='admin-limit'></span>
              </span>
              <select id='admin-locale'>
                <option value='zh'>中文</option>
                <option value='en'>English</option>
              </select>
              <small class='admin-hint'>英文文章请填写中文文章相同的 URL ID，作为翻译镜像。</small>
            </label>

            <label class='admin-field' data-post-field hidden>
              <span>文章日期</span>
              <input id='admin-publish-date' type='date' />
            </label>

            <label class='admin-field' data-note-field hidden>
              <span>笔记日期</span>
              <input id='admin-date' type='date' />
            </label>

            <label class='admin-field'>
              <span class='admin-field-label'>
                <span>标签（逗号分隔）</span>
                <span class='admin-limit'>最多 20 个</span>
              </span>
              <input id='admin-tags' placeholder='site, meta' spellcheck='false' />
            </label>

            <label class='admin-field' data-note-field hidden>
              <span>笔记类型</span>
              <select id='admin-note-type'>
                <option value='note'>note</option>
                <option value='snippet'>snippet</option>
                <option value='draft'>draft</option>
                <option value='idea'>idea</option>
                <option value='research'>research</option>
                <option value='reference'>reference</option>
              </select>
            </label>

            <label class='admin-field' data-note-field hidden>
              <span>笔记状态</span>
              <select id='admin-note-status'>
                <option value='in-progress'>in-progress</option>
                <option value='incomplete'>incomplete</option>
                <option value='ready'>ready</option>
                <option value='archived'>archived</option>
              </select>
            </label>

            <label class='admin-field'>
              <span class='admin-field-label'>
                <span>文章归属</span>
                <span class='admin-limit'>blog / notes</span>
              </span>
              <select id='admin-ownership'>
                <option value='blog'>blog</option>
                <option value='notes'>notes</option>
              </select>
              <small id='admin-ownership-hint' class='admin-hint'>
                blog 发布到 /blog，notes 发布到 /notes。切换归属会新建对应类型的内容。
              </small>
            </label>

            <label class='admin-field'>
              <span>格式</span>
              <select id='admin-format'>
                <option value='mdx'>Markdown MDX</option>
                <option value='md'>Plain Markdown</option>
              </select>
              <small id='admin-format-hint' class='admin-hint'
                >blog 默认 MDX，notes 默认 Markdown。</small
              >
            </label>
          </div>
        </details>

        <div class='admin-form-actions'>
          <label class='admin-check'>
            <input id='admin-draft' type='checkbox' checked />
            <span>保存为草稿（不公开）</span>
          </label>
          <div class='admin-form-buttons'>
            <button class='admin-btn admin-btn-ghost' type='button' id='admin-reset'>新建</button>
            <button class='admin-btn admin-save' type='submit' id='admin-submit'>保存草稿</button>
          </div>
        </div>
        <p id='admin-result' class='admin-status' aria-live='polite'></p>
      </form>
    </section>

    <section class='admin-card'>
      <div class='admin-card-head'>
        <h2 id='admin-list-title'>文章列表</h2>
        <span class='admin-eyebrow'>按日期倒序 · 含草稿</span>
      </div>
      <div id='admin-list' class='admin-list'>
        <p class='admin-status'>连接 token 后自动加载。</p>
      </div>
    </section>

    <details class='admin-card admin-media'>
      <summary class='admin-card-head'>
        <h2>图片 / 头像</h2>
        <span class='admin-eyebrow'>R2 MEDIA</span>
      </summary>
      <div class='admin-media-grid'>
        <form id='media-form' class='admin-media-item'>
          <input
            id='media-file'
            type='file'
            accept='image/*,image/svg+xml'
            aria-label='选择图片'
            required
          />
          <input
            id='media-key'
            placeholder='media/2026-10/banner.png（可留空自动命名）'
            spellcheck='false'
          />
          <button class='admin-btn' type='submit'>上传图片</button>
        </form>
        <form id='avatar-form' class='admin-media-item'>
          <input
            id='avatar-file'
            type='file'
            accept='image/*,image/svg+xml'
            aria-label='选择头像'
            required
          />
          <img id='avatar-preview' src='/api/v1/avatar' alt='当前头像' />
          <div class='admin-media-actions'>
            <button class='admin-btn' type='submit'>更新头像</button>
            <button class='admin-btn admin-btn-danger' type='button' id='avatar-delete'>
              删除头像
            </button>
          </div>
        </form>
      </div>
    </details>
  </main>
</BaseLayout>

<style>
  .admin-page {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.35rem;
  }

  .admin-toolbar,
  .admin-card {
    border: 1px solid hsl(var(--glass-edge));
    background-color: hsl(var(--glass-panel));
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      inset 0 1px 0 hsl(var(--glass-rim)),
      inset 0 0 0 1px hsl(var(--glass-inner)),
      0 18px 42px -26px hsl(var(--glass-shade));
    border-radius: 16px;
  }

  .admin-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.1rem 1.25rem;
  }

  .admin-toolbar-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .admin-eyebrow {
    color: hsl(var(--muted-foreground));
    font:
      500 0.7rem 'JetBrains Mono',
      ui-monospace,
      monospace;
    letter-spacing: 0.08em;
  }

  .admin-toolbar h1 {
    margin: 0.35rem 0 0.25rem;
    font-size: 1.55rem;
    font-weight: 700;
  }

  .admin-subtitle {
    color: hsl(var(--muted-foreground));
  }

  .admin-card {
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .admin-card-head,
  .admin-form-actions,
  .admin-media-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .admin-card-head h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 650;
  }

  .admin-chip {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.2rem 0.55rem;
    background: hsl(var(--muted) / 0.8);
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    font:
      500 0.75rem 'JetBrains Mono',
      ui-monospace,
      monospace;
  }

  .admin-chip[hidden] {
    display: none;
  }

