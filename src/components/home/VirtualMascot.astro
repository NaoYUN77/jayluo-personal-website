---
import { ghostQuietLabel, type HeroLine } from '@/data/ghost-lines'
import type { Lang } from '@/i18n/ui'

interface Props {
  lang: Lang
  heroLines?: HeroLine[]
}
const { lang, heroLines } = Astro.props
const label = lang === 'en' ? 'Boo, the pixel ghost' : 'Boo，像素小幽灵'
// Reference: ghost-pixels.py, 16×16 frames A and B.
const frameA = [
  '................',
  '.....OOOOOO.....',
  '...OOWWWWWWOO...',
  '..OWWWWWWWWWWO..',
  '.OWWWWWWWWWWWWO.',
  '.OWWWEEWWEEWWWO.',
  'OWWWWEEWWEEWWWSO',
  'OWWWWWWWWWWWWWSO',
  'OWWPPWWWWWWPPWSO',
  'OWWWWWWOOWWWWWSO',
  'OWWWWWWWWWWWWWSO',
  'OWWWWWWWWWWWWSSO',
  'OWWWWWWWWWWWWSSO',
  'OWWSOWWWSOWWWSSO',
  'OWSO.OWSO.OWSSO.',
  '.OO...OO...OOO..'
]
const frameB = [...frameA.slice(0, 13), 'OWWWSOWWWSOWWSSO', '.OWSO.OWSO.OWSO.', '..OO...OO...OO..']
const colors: Record<string, string> = {
  O: 'var(--ghost-outline, #212529)',
  W: '#ffffff',
  S: '#d3d3d3',
  E: '#ffffff', // White beneath the separately animated eyes.
  P: '#f4a6b8'
}
const pixels = (rows: string[], offset = 0) =>
  rows.flatMap((row, y) =>
    [...row].flatMap((color, x) =>
      colors[color] ? [{ x, y: y + offset, fill: colors[color] }] : []
    )
  )
---

<div
  class='ghost-pet'
  data-ghost-pet
  data-lang={lang}
  data-hero-mode={String(!!heroLines)}
  transition:persist='pixel-ghost'
>
  <button class='pixel-mascot' type='button' aria-label={label} title={label}>
    <svg viewBox='-2 -3 20 22' aria-hidden='true' shape-rendering='crispEdges'>
      <g class='ghost-action'>
        <g class='ghost-body'>
          {pixels(frameA.slice(0, 13)).map((pixel) => <rect {...pixel} width='1' height='1' />)}
          {
            [frameA, frameB].map((frame, index) => (
              <g class:list={['ghost-skirt', `ghost-skirt-${index}`]}>
                {pixels(frame.slice(13), 13).map((pixel) => (
                  <rect {...pixel} width='1' height='1' />
                ))}
              </g>
            ))
          }
          <g class='ghost-eyes' fill='#212529'>
            <rect x='5' y='5' width='2' height='2'></rect>
            <rect x='9' y='5' width='2' height='2'></rect>
          </g>
          <g class='ghost-sleep-eyes' fill='#212529'
            ><rect x='5' y='6' width='2' height='1'></rect><rect x='9' y='6' width='2' height='1'
            ></rect></g
          >
          <rect class='ghost-mouth' x='7' y='9' width='2' height='3' fill='#212529'></rect>
          <g class='ghost-happy-eyes' fill='#212529'>
            {
              [5, 9].map((x) => (
                <>
                  <rect x={x + 1} y='5' width='1' height='1' />
                  <rect x={x} y='6' width='1' height='1' />
                  <rect x={x + 2} y='6' width='1' height='1' />
                </>
              ))
            }
          </g>
        </g>
      </g>
    </svg>
    <span class='ghost-z' aria-hidden='true'>Z</span>
  </button>
  <div class='ghost-speech' data-ghost-bubble>
    <a class='ghost-line' data-ghost-speech href={heroLines?.[0]?.href}
      >{heroLines?.[0]?.text ?? ''}</a
    >
    <button type='button' class='ghost-quiet' data-ghost-quiet>{ghostQuietLabel[lang]}</button>
  </div>
  <span class='sr-only' data-ghost-live role='status' aria-live='polite' aria-atomic='true'></span>
</div>

<script>
  import { initGhost } from '@/lib/ghost'

  initGhost()
</script>

<style>
  .ghost-pet {
    --bubble-bg: #fff;
    --bubble-fg: #212529;
    position: fixed;
    right: max(12px, env(safe-area-inset-right));
    bottom: max(112px, env(safe-area-inset-bottom));
    width: 100px;
    z-index: 25;
    pointer-events: none;
  }
  .pixel-mascot {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: none;
  }
  .pixel-mascot:focus-visible {
    outline: 4px solid hsl(var(--primary));
    outline-offset: 4px;
  }
  svg {
    pointer-events: visiblePainted;
    width: 100%;
    overflow: visible;
  }
  :global(html.dark) .ghost-pet {
    --ghost-outline: #e9ecef;
    --bubble-bg: #212529;
    --bubble-fg: #fff;
  }
  .ghost-body {
    animation: float 2400ms steps(2, end) infinite;
  }
  .ghost-skirt-0 {
    animation: skirt 800ms steps(1, end) infinite;
  }
  .ghost-skirt-1 {
    opacity: 0;
    animation: skirt 800ms steps(1, end) infinite reverse;
  }
  .ghost-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5200ms steps(1, end) infinite;
  }
  .ghost-happy-eyes,
  .ghost-sleep-eyes,
  .ghost-mouth,
  .ghost-z {
    display: none;
  }
  .pixel-mascot:is(:hover, :focus-visible) .ghost-eyes {
    display: none;
  }
  .pixel-mascot:is(:hover, :focus-visible) .ghost-happy-eyes {
    display: inline;
  }
  .pixel-mascot:is(:hover, :focus-visible) .ghost-action {
    animation: hop 600ms steps(2, end) infinite;
  }
  .is-boo .ghost-action {
    animation: boo 450ms steps(2, end);
    transform-origin: 8px 8px;
  }
  .is-boo .ghost-mouth {
    display: inline;
  }
  .is-escaping .pixel-mascot {
    animation: escape 1800ms steps(8, end);
  }
  .is-sleeping .ghost-body,
  .is-sleeping .ghost-skirt,
  .is-sleeping .ghost-eyes {
    animation: none;
  }
  .is-sleeping .ghost-eyes,
  .is-sleeping .ghost-happy-eyes {
    display: none;
  }
  .is-sleeping .ghost-sleep-eyes,
  .is-sleeping .ghost-z {
    display: inline;
  }
  .ghost-z {
    position: absolute;
    top: 0;
    right: 0;
    font-family: var(--pixel-body);
    color: hsl(var(--foreground));
    animation: sleepy 2s steps(3, end) infinite;
  }
  .ghost-speech {
    position: absolute;
    bottom: calc(100% + 16px);
    right: 8px;
    width: max-content;
    max-width: min(280px, calc(100vw - 40px));
    padding: 12px 16px;
    border: 0;
    background: var(--bubble-bg);
    color: var(--bubble-fg);
    box-shadow:
      4px 0 0 var(--bubble-bg),
      -4px 0 0 var(--bubble-bg),
      0 4px 0 var(--bubble-bg),
      0 -4px 0 var(--bubble-bg),
      8px 0 0 var(--bubble-fg),
      -8px 0 0 var(--bubble-fg),
      0 8px 0 var(--bubble-fg),
      0 -8px 0 var(--bubble-fg),
      4px 4px 0 var(--bubble-fg),
      -4px 4px 0 var(--bubble-fg),
      4px -4px 0 var(--bubble-fg),
      -4px -4px 0 var(--bubble-fg);
    font-family: var(--pixel-body);
    font-size: 18px;
    line-height: 1.6;
    overflow-wrap: anywhere;
    opacity: 0;
    visibility: hidden;
  }
  .is-speaking .ghost-speech,
  .ghost-pet[data-hero-mode='true'] .ghost-speech {
    visibility: visible;
    opacity: 1;
  }
  .ghost-speech::after {
    content: '';
    position: absolute;
    right: 24px;
    bottom: -20px;
    width: 16px;
    height: 16px;
    background: var(--bubble-bg);
    border-left: 4px solid var(--bubble-fg);
    border-bottom: 4px solid var(--bubble-fg);
    box-shadow: 4px 0 0 var(--bubble-fg);
  }
  .ghost-line[href],
  .ghost-quiet {
    pointer-events: auto;
  }
  .ghost-line[href] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ghost-quiet {
    display: block;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 12px;
    min-height: 32px;
    padding: 6px 0 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ghost-quiet[hidden] {
    display: none;
  }
  .is-positioned {
    left: 0;
    top: 0;
    transform: translate(var(--ghost-x), var(--ghost-y));
    right: auto;
    bottom: auto;
  }
  .is-roaming {
    transition: transform 2s linear;
  }
  .is-scroll-paused {
    transition: none !important;
  }
  .is-scroll-paused * {
    animation-play-state: paused !important;
  }
  :global(#content),
  :global(.prose) {
    width: calc(100% - var(--boo-reading-gutter, 0px));
    min-width: 0;
  }
  @media (max-width: 767px) {
    .ghost-pet:not([data-hero-mode='true']) {
      bottom: calc(152px + env(safe-area-inset-bottom));
    }
  }
  .is-looking .ghost-eyes {
    animation: look 800ms steps(1, end) 2;
  }
  .is-cameo[data-cameo='title'] .pixel-mascot {
    clip-path: inset(0 0 25%);
  }
  :global(.boot-running) .ghost-pet .ghost-speech {
    visibility: hidden !important;
  }
  .hide-bubble .ghost-speech {
    visibility: hidden;
    pointer-events: none;
  }
  .is-cameo[data-cameo='image'] .ghost-body {
    animation: none;
    transform-origin: 8px 1px;
    transform: rotate(8deg);
  }
  .is-cameo[data-cameo='end'] .ghost-body {
    animation: none;
    transform-origin: 8px 16px;
    transform: scaleY(0.8);
  }
  .is-obstructed {
    visibility: hidden;
  }
  .is-obstructed .ghost-speech {
    visibility: hidden !important;
  }
  .is-obstructed svg {
    pointer-events: none;
  }
  .is-obstructed .pixel-mascot {
    pointer-events: none;
  }
  .ghost-pet[data-hero-mode='true'] {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 100%;
    max-width: 100%;
    z-index: 1;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 32px;
    min-height: 400px;
  }
  .ghost-pet[data-hero-mode='true'] .pixel-mascot {
    grid-row: 2;
    width: 220px;
    max-width: 100%;
  }
  .ghost-pet[data-hero-mode='true'] .ghost-speech {
    grid-row: 1;
    position: relative;
    bottom: auto;
    left: auto;
    right: auto;
    width: 70%;
    min-height: 110px;
    max-width: 100%;
    pointer-events: auto;
  }
  .ghost-pet[data-hero-mode='true'] .ghost-speech::after {
    left: calc(50% - 10px);
    right: auto;
  }
  @keyframes look {
    25% {
      transform: translateX(-1px);
    }
    75% {
      transform: translateX(1px);
    }
  }
  @media (max-width: 1024px) {
    .ghost-pet {
      width: 80px;
    }
  }
  @keyframes float {
    50% {
      transform: translateY(-2px);
    }
  }
  @keyframes skirt {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  @keyframes blink {
    0%,
    94%,
    98%,
    100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.25);
    }
  }
  @keyframes hop {
    50% {
      transform: translateY(-2px);
    }
  }
  @keyframes boo {
    30%,
    70% {
      transform: scale(1.2);
    }
  }
  @keyframes escape {
    40%,
    60% {
      transform: translateX(calc(-100vw - 100%));
    }
  }
  @keyframes sleepy {
    to {
      transform: translateY(-12px);
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    :global(body) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
    .ghost-pet {
      width: 60px;
      right: max(8px, env(safe-area-inset-right));
      bottom: max(112px, env(safe-area-inset-bottom));
    }
  }
  @media (max-width: 640px) {
    .ghost-speech {
      font-size: 16px;
    }
    .ghost-quiet {
      min-height: 44px;
    }
    .ghost-pet[data-hero-mode='true'] {
      min-height: 340px;
    }
    .ghost-pet[data-hero-mode='true'] .pixel-mascot {
      width: 160px;
    }
    .ghost-pet[data-hero-mode='true'] .ghost-speech {
      width: calc(100% - 16px);
      min-height: 110px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-roaming {
      transition: none;
    }
    .ghost-pet *,
    .pixel-mascot:is(:hover, :focus-visible) .ghost-action {
      animation: none !important;
    }
  }
</style>
