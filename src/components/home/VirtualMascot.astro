---
import type { Lang } from '@/i18n/ui'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const label = lang === 'en' ? 'Boo, the pixel ghost' : 'Boo，像素小幽灵'
// Reference: ghost-pixels.py, 16×16 frames A and B.
const frameA = [
  '................',
  '.....OOOOOO.....',
  '...OOWWWWWWOO...',
  '..OWWWWWWWWWWO..',
  '.OWWWWWWWWWWWWO.',
  '.OWWWEEWWEEWWWO.',
  'OWWWWEEWWEEWWWSO',
  'OWWWWWWWWWWWWWSO',
  'OWWPPWWWWWWPPWSO',
  'OWWWWWWOOWWWWWSO',
  'OWWWWWWWWWWWWWSO',
  'OWWWWWWWWWWWWSSO',
  'OWWWWWWWWWWWWSSO',
  'OWWSOWWWSOWWWSSO',
  'OWSO.OWSO.OWSSO.',
  '.OO...OO...OOO..'
]
const frameB = [...frameA.slice(0, 13), 'OWWWSOWWWSOWWSSO', '.OWSO.OWSO.OWSO.', '..OO...OO...OO..']
const colors: Record<string, string> = {
  O: 'var(--ghost-outline, #212529)',
  W: '#ffffff',
  S: '#d3d3d3',
  E: '#ffffff', // White beneath the separately animated eyes.
  P: '#f4a6b8'
}
const pixels = (rows: string[], offset = 0) =>
  rows.flatMap((row, y) =>
    [...row].flatMap((color, x) =>
      colors[color] ? [{ x, y: y + offset, fill: colors[color] }] : []
    )
  )
---

<div class='ghost-pet' data-ghost-pet data-lang={lang} transition:persist='pixel-ghost'>
  <button class='pixel-mascot' type='button' aria-label={label} title={label}>
    <svg viewBox='-2 -3 20 22' aria-hidden='true' shape-rendering='crispEdges'>
      <g class='ghost-action'>
        <g class='ghost-body'>
          {pixels(frameA.slice(0, 13)).map((pixel) => <rect {...pixel} width='1' height='1' />)}
          {
            [frameA, frameB].map((frame, index) => (
              <g class:list={['ghost-skirt', `ghost-skirt-${index}`]}>
                {pixels(frame.slice(13), 13).map((pixel) => (
                  <rect {...pixel} width='1' height='1' />
                ))}
              </g>
            ))
          }
          <g class='ghost-eyes' fill='#212529'>
            <rect x='5' y='5' width='2' height='2'></rect>
            <rect x='9' y='5' width='2' height='2'></rect>
          </g>
          <g class='ghost-sleep-eyes' fill='#212529'
            ><rect x='5' y='6' width='2' height='1'></rect><rect x='9' y='6' width='2' height='1'
            ></rect></g
          >
          <rect class='ghost-mouth' x='7' y='9' width='2' height='3' fill='#212529'></rect>
          <g class='ghost-happy-eyes' fill='#212529'>
            {
              [5, 9].map((x) => (
                <>
                  <rect x={x + 1} y='5' width='1' height='1' />
                  <rect x={x} y='6' width='1' height='1' />
                  <rect x={x + 2} y='6' width='1' height='1' />
                </>
              ))
            }
          </g>
        </g>
      </g>
    </svg>
    <span class='ghost-z' aria-hidden='true'>Z</span>
  </button>
  <span class='ghost-speech' data-ghost-speech aria-hidden='true'></span>
  <span class='sr-only' data-ghost-live role='status' aria-live='polite' aria-atomic='true'></span>
</div>

<script>
  import { initGhost } from '@/lib/ghost'

  initGhost()
</script>

<style>
  .ghost-pet {
    --bubble-bg: #fff;
    --bubble-fg: #212529;
    position: fixed;
    left: max(12px, env(safe-area-inset-left));
    bottom: max(16px, env(safe-area-inset-bottom));
    width: 80px;
    z-index: 25;
    pointer-events: none;
  }
  .pixel-mascot {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }
  .pixel-mascot:focus-visible {
    outline: 4px solid hsl(var(--primary));
    outline-offset: 4px;
  }
  svg {
    width: 100%;
    overflow: visible;
  }
  :global(html.dark) .ghost-pet {
    --ghost-outline: #e9ecef;
    --bubble-bg: #212529;
    --bubble-fg: #fff;
  }
  .ghost-body {
    animation: float 2400ms steps(2, end) infinite;
  }
  .ghost-skirt-0 {
    animation: skirt 800ms steps(1, end) infinite;
  }
  .ghost-skirt-1 {
    opacity: 0;
    animation: skirt 800ms steps(1, end) infinite reverse;
  }
  .ghost-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5200ms steps(1, end) infinite;
  }
  .ghost-happy-eyes,
  .ghost-sleep-eyes,
  .ghost-mouth,
  .ghost-z {
    display: none;
  }
  .pixel-mascot:is(:hover, :focus-visible) .ghost-eyes {
    display: none;
  }
  .pixel-mascot:is(:hover, :focus-visible) .ghost-happy-eyes {
    display: inline;
  }
  .pixel-mascot:is(:hover, :focus-visible) .ghost-action {
    animation: hop 600ms steps(2, end) infinite;
  }
  .is-boo .ghost-action {
    animation: boo 450ms steps(2, end);
    transform-origin: 8px 8px;
  }
  .is-boo .ghost-mouth {
    display: inline;
  }
  .is-escaping .pixel-mascot {
    animation: escape 1800ms steps(8, end);
  }
  .is-sleeping .ghost-body,
  .is-sleeping .ghost-skirt,
  .is-sleeping .ghost-eyes {
    animation: none;
  }
  .is-sleeping .ghost-eyes,
  .is-sleeping .ghost-happy-eyes {
    display: none;
  }
  .is-sleeping .ghost-sleep-eyes,
  .is-sleeping .ghost-z {
    display: inline;
  }
  .ghost-z {
    position: absolute;
    top: 0;
    right: 0;
    font-family: var(--pixel-body);
    color: hsl(var(--foreground));
    animation: sleepy 2s steps(3, end) infinite;
  }
  .ghost-speech {
    position: absolute;
    bottom: calc(100% + 16px);
    left: 8px;
    width: max-content;
    max-width: min(280px, calc(100vw - 40px));
    padding: 12px 16px;
    border: 0;
    background: var(--bubble-bg);
    color: var(--bubble-fg);
    box-shadow:
      4px 0 0 var(--bubble-bg),
      -4px 0 0 var(--bubble-bg),
      0 4px 0 var(--bubble-bg),
      0 -4px 0 var(--bubble-bg),
      8px 0 0 var(--bubble-fg),
      -8px 0 0 var(--bubble-fg),
      0 8px 0 var(--bubble-fg),
      0 -8px 0 var(--bubble-fg),
      4px 4px 0 var(--bubble-fg),
      -4px 4px 0 var(--bubble-fg),
      4px -4px 0 var(--bubble-fg),
      -4px -4px 0 var(--bubble-fg);
    font-family: var(--pixel-body);
    font-size: 16px;
    line-height: 1.6;
    overflow-wrap: anywhere;
    opacity: 0;
  }
  .is-speaking .ghost-speech {
    opacity: 1;
  }
  .ghost-speech::after {
    content: '';
    position: absolute;
    left: 24px;
    bottom: -20px;
    width: 16px;
    height: 16px;
    background: var(--bubble-bg);
    border-left: 4px solid var(--bubble-fg);
    border-bottom: 4px solid var(--bubble-fg);
    box-shadow: 4px 0 0 var(--bubble-fg);
  }
  @keyframes float {
    50% {
      transform: translateY(-2px);
    }
  }
  @keyframes skirt {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  @keyframes blink {
    0%,
    94%,
    98%,
    100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.25);
    }
  }
  @keyframes hop {
    50% {
      transform: translateY(-2px);
    }
  }
  @keyframes boo {
    30%,
    70% {
      transform: scale(1.2);
    }
  }
  @keyframes escape {
    40%,
    60% {
      transform: translateX(calc(-100% - 100px));
    }
  }
  @keyframes sleepy {
    to {
      transform: translateY(-12px);
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    :global(body) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
    .ghost-pet {
      width: 48px;
      left: max(4px, env(safe-area-inset-left));
      bottom: max(8px, env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ghost-pet *,
    .pixel-mascot:is(:hover, :focus-visible) .ghost-action {
      animation: none !important;
    }
  }
</style>
