---
import type { Lang } from '@/i18n/ui'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const label = lang === 'en' ? "Greet Jayluo's virtual avatar" : '和 Jayluo 的虚拟形象打招呼'
---

<button class='pixel-mascot' type='button' aria-label={label} title={label} data-pixel-mascot>
  <span class='pixel-mascot-meta' aria-hidden='true'><span>JAY / 01</span><span>READY</span></span>
  <svg viewBox='0 0 64 40' aria-hidden='true' shape-rendering='crispEdges'>
    <path
      class='pixel-ground'
      d='M4 36h56v1H4zM8 32h2v2H8zM54 28h2v2h-2zM5 10h4v1H5zM7 8h1v5H7zM53 6h4v1h-4zM55 4h1v5h-1z'
    ></path>
    <g class='pixel-person'>
      <path
        fill='currentColor'
        d='M25 5h14v2h3v3h2v13h-3v3h-3v2h4v3h3v5H19v-5h3v-3h4v-2h-3v-3h-3V10h2V7h3z'></path>
      <path class='pixel-face' d='M25 12h14v3h2v7h-3v3H26v-3h-3v-7h2z'></path>
      <path fill='currentColor' d='M26 16h4v4h-4zM35 16h4v4h-4zM30 22h5v1h-5z'></path>
      <path class='pixel-shirt' d='M27 28h10l-5 5zM30 33h4v3h-4z'></path>
      <g class='pixel-hand'
        ><path fill='currentColor' d='M42 26h5v-4h3v-6h3v10h-3v4h-8z'></path><path
          class='pixel-face'
          d='M49 16h3v5h-3z'></path></g
      >
    </g>
  </svg>
  <span class='pixel-mascot-caption' aria-hidden='true'
    >{lang === 'en' ? 'HELLO, WORLD!' : '你好，世界！'}</span
  >
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pixel-mascot]').forEach((button) => {
    button.addEventListener('click', () => {
      button.classList.remove('is-waving')
      requestAnimationFrame(() => button.classList.add('is-waving'))
    })
    button.addEventListener('animationend', () => button.classList.remove('is-waving'))
  })
</script>

<style>
  .pixel-mascot {
    display: grid;
    width: 100%;
    padding: 12px;
    gap: 12px;
    border: 4px solid hsl(var(--foreground));
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
    text-align: left;
  }
  .pixel-mascot-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--pixel-display);
    font-size: 8px;
    line-height: 2;
  }
  svg {
    width: 100%;
    border: 4px solid currentColor;
    background: hsl(var(--background));
  }
  .pixel-face,
  .pixel-shirt {
    fill: hsl(var(--background));
  }
  .pixel-ground {
    fill: hsl(var(--border));
  }
  .pixel-mascot-caption {
    text-align: center;
    font-size: 12px;
    line-height: 2;
  }
  .pixel-hand {
    transform-origin: 44px 28px;
  }
  .pixel-mascot:hover .pixel-hand,
  .is-waving .pixel-hand {
    animation: wave 600ms steps(2, end) 2;
  }
  @keyframes wave {
    50% {
      transform: rotate(-20deg);
    }
  }
</style>
