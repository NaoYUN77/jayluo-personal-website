<style is:inline>
#boot-screen{position:fixed;inset:0;z-index:2147483646;padding:24px;background:#212529;color:#fff;font:10px/2 'Press Start 2P',monospace;display:flex;flex-direction:column;overflow:hidden;touch-action:none}
#boot-screen[hidden],#boot-progress[hidden]{display:none}
#boot-terminal{overflow:hidden;flex:0 1 auto;min-height:0;max-height:calc(100% - 110px)}
#boot-terminal p{margin:0;white-space:pre;overflow:hidden;text-overflow:clip;font:inherit}
#boot-terminal .boot-kernel{color:#8c8c8c}
#boot-terminal b,#boot-welcome{color:#51cf66;font-weight:400}
#boot-progress{display:flex;align-items:center;gap:10px;margin-top:28px;width:min(580px,100%);height:32px;flex-shrink:0}
#boot-beans{display:flex;justify-content:space-between;align-items:center;position:relative;flex:1;min-width:0}
#boot-beans i{width:4px;height:4px;background:#fff;flex-shrink:0}
#boot-percent{min-width:4ch;text-align:right}
#boot-boo{position:absolute;width:48px;height:48px;bottom:-14px;left:0;transform:translateX(-100%);overflow:visible}
#boot-boo .boot-closed,#boot-boo .boot-happy{display:none}
#boot-boo[data-frame="1"] .boot-open,#boot-boo[data-happy] .boot-open,#boot-boo[data-happy] .boot-closed{display:none}
#boot-boo[data-frame="1"]:not([data-happy]) .boot-closed,#boot-boo[data-happy] .boot-happy{display:inline}
#boot-welcome{margin-top:16px;min-height:2em}
#boot-tiles{position:absolute;inset:0;display:grid;grid-template-columns:repeat(var(--cols),32px);pointer-events:none}
#boot-tiles i{width:32px;height:32px;background:hsl(var(--background,0 0% 100%));transform:scale(0);transition:transform 100ms steps(4,end)}
.boot-running [data-ghost-pet]{visibility:hidden!important}
@media(max-width:640px){#boot-screen{padding:16px;font-size:8px;line-height:2}#boot-boo{width:32px;height:32px;bottom:-10px}#boot-beans i{width:3px;height:3px}}
@media(prefers-reduced-motion:reduce){#boot-screen{display:none!important}}
</style>
